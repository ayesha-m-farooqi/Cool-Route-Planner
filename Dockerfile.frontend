# Cool Route Planner — frontend (React + Vite, served by nginx)

# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Optional override — leave unset and calls go to relative "/api/...",
# which nginx.conf proxies to the backend container. Only set this if
# the backend is NOT sitting behind this frontend's nginx (see
# src/App.jsx BACKEND_URL).
ARG VITE_BACKEND_URL=""
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

RUN npm run build

# ---- serve stage ----
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5782

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -qO- http://localhost:5782/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
