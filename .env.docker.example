# Copy to `.env` (same dir as docker-compose.yml). docker compose loads
# it automatically — both vars are optional.

# Only needed by backend/fortyguard_pipeline.py (data-refresh script, not
# used by the running API). Safe to leave blank.
FORTYGUARD_API_KEY=

# Only needed if frontend and backend are NOT on the same host/IP
# (e.g. backend behind its own domain or reverse proxy). Leave blank to
# auto-detect http://<server-host>:5772 at runtime.
VITE_BACKEND_URL=
